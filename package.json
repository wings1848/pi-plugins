      "node_modules/@vndv/pi-codegraph/extensions",
      "node_modules/pi-mcp-adapter/index.ts",
      "node_modules/@llblab/pi-telegram/index.ts",
      "node_modules/@wingsbutterfly/pi-zh/extensions",

    "@vndv/pi-codegraph": "*",
    "@wingsbutterfly/pi-zh": "*",
    "pi-config-sync": "*",
    "pi-image-tools": "*",
    "pi-mcp-adapter": "*",
    "pi-rtk-optimizer": "*",
    "pi-stats-footer": "*",
    "pi-subagents": "*",
    "pi-tool-display": "*"
  },
  "bundledDependencies": [
    "@agent-sh/computer-use-linux",
    "@juicesharp/rpiv-ask-user-question",
    "@juicesharp/rpiv-todo",
    "@juicesharp/rpiv-web-tools",
    "@llblab/pi-telegram",
    "@vndv/pi-codegraph",
    "@wingsbutterfly/pi-zh",
    "pi-config-sync",
    "pi-image-tools",
    "pi-mcp-adapter",
    "pi-rtk-optimizer",
    "pi-stats-footer",

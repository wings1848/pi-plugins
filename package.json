{
  "name": "pi-plugins",
  "version": "1.1.0",
  "description": "wings1848's curated pi coding agent plugin collection - install all plugins with one command",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@agent-sh/computer-use-linux": "*",
    "@juicesharp/rpiv-ask-user-question": "*",
    "@juicesharp/rpiv-todo": "*",
